# Multi stage production image for Coolify.
# Build context must be the repository root (needs shared/).
FROM node:20-alpine AS builder

ENV NODE_ENV=development

WORKDIR /build

COPY admin_frontend/package*.json ./admin_frontend/
WORKDIR /build/admin_frontend
RUN --mount=type=cache,id=npm-admin-frontend,target=/root/.npm npm install

COPY admin_frontend/ ./
COPY shared/ ./shared/

ARG VITE_API_URL=
ARG VITE_ADMIN_SECRET=

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ADMIN_SECRET=$VITE_ADMIN_SECRET

RUN npm run build

FROM nginx:alpine

COPY --from=builder /build/admin_frontend/dist /usr/share/nginx/html
COPY nginx/spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
