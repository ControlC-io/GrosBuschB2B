# GrosBuschB2B — copy to .env and fill in your values

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=grosbuschb2b
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/grosbuschb2b?schema=public

# App
NODE_ENV=development
ADMIN_SECRET=change_me
JWT_SECRET=change_me
JWT_EXPIRES_IN=8h

# Better Auth
BETTER_AUTH_SECRET=change_me
BETTER_AUTH_URL=http://localhost
TRUSTED_ORIGINS=http://localhost,http://localhost:5174

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email / SendGrid (for 2FA OTP)
SENDGRID_API_KEY=your_key_here
SENDGRID_FROM_EMAIL=noreply@example.com
EMAIL_SERVICE_SECRET=change_me
EMAIL_SERVICE_PORT=3001
EMAIL_SERVICE_URL=http://email_service:3001

# Object Storage (MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_BUCKET=grosbuschb2b-documents

# External API (optional — remove if unused)
VITE_API_BASE_URL=https://api.example.com
VITE_API_KEY=
VITE_API_BEARER_TOKEN=
