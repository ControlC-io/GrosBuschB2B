# Production environment variables for Coolify.
# Copy paste into Coolify → Environment Variables → Production.
# Replace every value marked with CHANGE_ME.

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=grosbuschb2b
DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_db_password@postgres:5432/grosbuschb2b?schema=public

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
ADMIN_SECRET=CHANGE_ME_admin_secret
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=8h

# ── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
# Public URL of the main app (must match your main Coolify domain)
BETTER_AUTH_URL=https://CHANGE_ME_app_domain.com
# Comma separated list of allowed browser origins (main app + admin panel)
TRUSTED_ORIGINS=https://CHANGE_ME_app_domain.com,https://CHANGE_ME_admin_domain.com

# ── OAuth (optional) ─────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Email / SendGrid (required for email OTP 2FA) ────────────────────────────
SENDGRID_API_KEY=CHANGE_ME_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@CHANGE_ME_your_domain.com
EMAIL_SERVICE_SECRET=CHANGE_ME_email_service_secret
EMAIL_SERVICE_PORT=3001
EMAIL_SERVICE_URL=http://email_service:3001

# ── Main frontend (build time) ───────────────────────────────────────────────
# Leave empty so the browser uses same origin /api and /external-api paths.
VITE_API_URL=
# Optional external accounting / tickets API (proxied by nginx as /external-api)
VITE_API_BASE_URL=
VITE_API_KEY=
VITE_API_BEARER_TOKEN=

# ── Admin frontend (build time) ───────────────────────────────────────────────
# Must match ADMIN_SECRET above. Baked into the admin SPA at build time.
VITE_ADMIN_SECRET=CHANGE_ME_admin_secret

# ── Nginx routing (runtime, used by nginx.coolify.conf via envsubst) ─────────
MAIN_APP_DOMAIN=CHANGE_ME_app_domain.com
ADMIN_APP_DOMAIN=CHANGE_ME_admin_domain.com
# Optional upstream for /external-api (defaults to VITE_API_BASE_URL at build)
EXTERNAL_API_UPSTREAM=
