# Multi stage production image for Coolify.
# Build context must be the repository root (needs shared/).
FROM node:20-alpine AS builder

ENV NODE_ENV=development

WORKDIR /build

COPY main_frontend/package*.json ./main_frontend/
WORKDIR /build/main_frontend
RUN --mount=type=cache,id=npm-main-frontend,target=/root/.npm npm install

COPY main_frontend/ ./
COPY shared/ /build/shared/

ARG VITE_API_URL=
ARG VITE_API_BASE_URL=
ARG VITE_API_KEY=
ARG VITE_API_BEARER_TOKEN=

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_API_KEY=$VITE_API_KEY
ENV VITE_API_BEARER_TOKEN=$VITE_API_BEARER_TOKEN

RUN npm run build

FROM nginx:alpine

COPY --from=builder /build/main_frontend/dist /usr/share/nginx/html
COPY nginx/spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
